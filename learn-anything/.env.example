# Required — powers the mind map, timeline, flashcards, and quiz
# Free — get one at https://aistudio.google.com/app/apikey (no card required)
GEMINI_API_KEY=

# Required for the YouTube videos section
# Get one at https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# Optional — raises the GitHub search rate limit from 10/min to 30/min
# Create a classic token with no scopes at https://github.com/settings/tokens
GITHUB_TOKEN=
